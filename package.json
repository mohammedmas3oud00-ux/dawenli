{
  "name": "dawenli",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.14 <23",
    "npm": ">=10"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsup server.ts --format esm --platform node --out-dir build --clean",
    "preview": "vite preview",
    "start": "node build/server.js --production",
    "clean": "node -e \"for(const p of ['dist','build'])require('fs').rmSync(p,{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --ignore-path .prettierignore.incremental --check PROJECT_MAP.md eslint.config.js index.html package.json playwright.config.ts playwright.production.config.ts scripts/verify-supabase-security.mjs scripts/verify-supabase-sync.mjs src/components/hierarchical/focusSessionLogic.ts src/components/hierarchical/focusSessionLogic.test.ts src/components/hierarchical/inboxConversion.ts src/components/hierarchical/inboxConversion.test.ts src/components/hierarchical/prayerTimesRefresh.ts src/components/hierarchical/prayerTimesRefresh.test.ts src/features/calendar/utils/reminder.ts src/features/calendar/utils/reminder.test.ts src/shared/services/pushSecurity.ts src/shared/services/pushSecurity.test.ts tsconfig.json vercel.json vitest.config.ts",
    "format:check:all": "prettier --check .",
    "test": "vitest run --maxWorkers=1",
    "test:coverage": "vitest run --coverage --maxWorkers=1",
    "test:supabase": "tsx scripts/verify-supabase-sync.mjs",
    "test:supabase:security": "node scripts/verify-supabase-security.mjs",
    "test:supabase:security:local": "supabase db query --local --file supabase/tests/security_integrity.sql && supabase db query --local --file supabase/tests/ibadat_rls.sql",
    "test:supabase:lint": "supabase db lint --local --level warning --fail-on warning",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.117.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "supabase": "^2.118.0",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
